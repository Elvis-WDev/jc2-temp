# Despliegue de produccion. Copia a `.env.production` y rellena.
#
#   cp .env.production.example .env.production
#   docker compose --env-file .env.production up -d --build
#
# `.env.production` NUNCA se versiona: `.gitignore` cubre `.env*`. Solo hay
# marcadores aqui, jamas valores reales.
#
# Este archivo es para Docker. `.env.example` es el del entorno de desarrollo, con
# otros valores por defecto; no se mezclan.

# ---------------------------------------------------------------------------
# Base de datos externa
# ---------------------------------------------------------------------------

# La base NO forma parte de este despliegue. Apunta a la tuya.
#
# - Desde un contenedor, `localhost` es el propio contenedor. Para una base en la
#   misma maquina usa `host.docker.internal` (y anade `extra_hosts` en compose) o la
#   IP de la interfaz del anfitrion.
# - Usuario de minimo privilegio: le basta con leer y escribir en su esquema. No
#   necesita ser superusuario despues de la primera migracion.
# - Con TLS, anade `?sslmode=require` (o `verify-full` si validas el certificado).
DATABASE_URL=postgresql://usuario:contrasena@servidor:5432/basededatos?schema=public

# ---------------------------------------------------------------------------
# Direccion publica
# ---------------------------------------------------------------------------

# El origen por el que se llega al sitio, con https y sin barra final. De aqui salen
# las direcciones del sitemap, los enlaces canonicos y las de los archivos publicos.
#
# Tambien es el origen de CORS y el de la cookie de sesion: si no coincide con la
# direccion real del navegador, no se puede iniciar sesion.
PUBLIC_BASE_URL=https://ejemplo.edu

# ---------------------------------------------------------------------------
# Autenticacion
# ---------------------------------------------------------------------------

# Minimo 32 caracteres. Generar con:  openssl rand -base64 48
# Cambiarlo cierra todas las sesiones abiertas.
BETTER_AUTH_SECRET=

# El unico administrador. Los crea el seeder en el primer despliegue.
#
# Si el correo ya existe, el seeder NO toca la contrasena: cambiarla aqui despues no
# sirve de nada. Para cambiarla se hace desde el panel.
#
# CUIDADO con el `$`: en un fichero de entorno se lee como el principio de una
# variable, asi que `Clave$Segura2026` llega como `Clave` y la validacion la
# rechaza por corta. Lo mismo si la pegas con comillas: se las come.
# Lo mas seguro es generarla sin caracteres raros:
#
#   openssl rand -hex 24
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Site Administrator

# ---------------------------------------------------------------------------
# Como se llega al sitio
# ---------------------------------------------------------------------------
#
# No hay variables que rellenar: ningun contenedor publica puerto en el anfitrion.
# El proxy que termina TLS enruta por dominio hasta `web:80` dentro de la red
# `dokploy-network`.
#
# En Dokploy se configura en Domains: servicio `web`, Container Port 80, HTTPS
# encendido. Fuera de Dokploy hay que crear la red y apuntar tu proxy ahi:
#
#   docker network create dokploy-network
#
# El sitio necesita HTTPS: la cookie de sesion es `Secure` y no viaja por HTTP.

# ---------------------------------------------------------------------------
# Opcionales: los valores por defecto sirven
# ---------------------------------------------------------------------------

# 100 MB. Si lo subes, sube tambien `client_max_body_size` en `web/nginx.conf`.
MAX_UPLOAD_BYTES=104857600

# Peticiones por minuto y por IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# El publico va mas holgado: una ficha con galeria pide muchos archivos de golpe, y
# una oficina entera comparte una IP.
PUBLIC_RATE_LIMIT_MAX=600
LOGIN_RATE_LIMIT_MAX=5

LOG_LEVEL=info

# Etiqueta de las imagenes. Con una version por despliegue puedes volver atras.
IMAGE_TAG=latest

# Copia a .env y rellena. El .env real NUNCA se versiona.
# Solo placeholders aqui, jamas valores reales (security/principles.md:19-24).
#
# Un unico archivo compartido por api/ y web/.
#
# AVISO: Vite lee este archivo pero SOLO expone al navegador las variables con
# prefijo VITE_. Todo lo demas se queda en el servidor. Nunca anadir el prefijo
# VITE_ a un secreto.

# ---------------------------------------------------------------------------
# Panel (web/) — se incrusta en el bundle al compilar
# ---------------------------------------------------------------------------

# Vacio a proposito: el sitio y la API comparten origen. Las peticiones salen
# relativas y las reenvia Vite en desarrollo y nginx en produccion. Rellenala solo si
# despliegas la API en otro dominio, y entonces debe coincidir EXACTAMENTE con un
# origen de CORS_ORIGIN o la cookie de sesion no viajara.
VITE_API_URL=

# ---------------------------------------------------------------------------
# API (api/) — solo servidor
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# PostgreSQL. En produccion, credenciales de minimo privilegio tras migrar.
DATABASE_URL=postgresql://jc2:jc2@localhost:5432/jc2?schema=public

# Minimo 32 caracteres. Generar con: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:4000

# Lista separada por comas. Sin comodines: cada origen se declara.
CORS_ORIGIN=http://localhost:3000

# El origen del SITIO, no el de la API: es el prefijo de las direcciones de archivo
# que la API entrega al publico y de la imagen de OpenGraph. Con un solo origen las
# dos cosas coinciden.
PUBLIC_BASE_URL=http://localhost:3000

# Raiz del almacenamiento. Relativa a api/, y fuera de cualquier ruta servida
# estaticamente.
STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=104857600

LOG_LEVEL=info

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# El publico va aparte y mas holgado: una ficha con galeria pide muchos archivos
# de golpe, y una oficina entera comparte una IP.
PUBLIC_RATE_LIMIT_MAX=600
LOGIN_RATE_LIMIT_MAX=5

# Credenciales del unico administrador. Las consume el seeder.
# Minimo 12 caracteres en la contrasena.
ADMIN_EMAIL=replace-with-email
ADMIN_PASSWORD=replace-with-secure-password
ADMIN_NAME=replace-with-name
